# SenseNova profile. Fill BASE_URL with the Anthropic-compatible gateway URL
# shown in your SenseNova account documentation. Do not commit the real key.
FREECONTEXT_API=anthropic
FREECONTEXT_AUTH_MODE=bearer
FREECONTEXT_BASE_URL=https://YOUR-SENSENOVA-ANTHROPIC-COMPATIBLE-BASE
FREECONTEXT_MODEL=sensenova-6.7-flash-lite
FREECONTEXT_API_KEY=

FREECONTEXT_MAX_TURNS=8
FREECONTEXT_MAX_TOOL_CALLS=32
FREECONTEXT_MAX_OUTPUT_TOKENS=4096
FREECONTEXT_REQUEST_TIMEOUT_MS=180000
FREECONTEXT_TOOL_TIMEOUT_MS=20000
FREECONTEXT_MAX_TOOL_OUTPUT_BYTES=65536
FREECONTEXT_MAX_PARALLEL_TOOLS=8
FREECONTEXT_CONTEXT_WINDOW=128000
FREECONTEXT_TEMPERATURE=0
FREECONTEXT_THINKING_LEVEL=off
