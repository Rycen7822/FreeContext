# Store this file at ~/.config/freecontext/.env, or pass --env /path/to/.env.
# Never commit the populated file.

FREECONTEXT_API=anthropic
FREECONTEXT_AUTH_MODE=auto
FREECONTEXT_BASE_URL=https://api.anthropic.com
FREECONTEXT_MODEL=claude-model-id
FREECONTEXT_API_KEY=

# Runtime limits
FREECONTEXT_MAX_TURNS=8
FREECONTEXT_MAX_TOOL_CALLS=32
FREECONTEXT_MAX_OUTPUT_TOKENS=4096
FREECONTEXT_REQUEST_TIMEOUT_MS=180000
FREECONTEXT_TOOL_TIMEOUT_MS=20000
FREECONTEXT_MAX_TOOL_OUTPUT_BYTES=65536
FREECONTEXT_MAX_PARALLEL_TOOLS=8

# Optional model metadata and compatibility controls
FREECONTEXT_CONTEXT_WINDOW=128000
FREECONTEXT_TEMPERATURE=0
FREECONTEXT_THINKING_LEVEL=off
FREECONTEXT_HEADERS_JSON={}
FREECONTEXT_OPENAI_SUPPORTS_DEVELOPER_ROLE=false
FREECONTEXT_OPENAI_SUPPORTS_REASONING_EFFORT=false
FREECONTEXT_OPENAI_SUPPORTS_USAGE_IN_STREAMING=false
FREECONTEXT_OPENAI_SUPPORTS_STRICT_MODE=false
