{
  "name": "freecontext",
  "version": "0.1.0",
  "description": "Read-only repository exploration subagent for Codex, built on the Pi agent loop.",
  "type": "module",
  "bin": {
    "freecontext": "./bin/freecontext.mjs",
    "freecontext-benchmark-context": "./bin/freecontext-benchmark-context.mjs",
    "freecontext-mcp": "./bin/freecontext-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "benchmarks",
    "dist",
    "prompts",
    "skills",
    ".codex-plugin",
    "docs",
    "scripts/install-codex-skill.sh",
    ".mcp.json",
    "freecontext.example.toml",
    "freecontext.sensenova.example.toml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:core": "node --import tsx --test test/*.test.ts",
    "check": "node --import tsx scripts/static-check.ts",
    "smoke:mock": "node --import tsx scripts/mock-smoke.ts",
    "smoke:mcp": "node --import tsx scripts/mcp-smoke.ts",
    "smoke:live": "node --import tsx scripts/live-smoke.ts",
    "bench:mock": "node --import tsx scripts/benchmark-mock.ts --scenario baseline",
    "bench:context": "node --import tsx scripts/benchmark-mock.ts --scenario context",
    "bench:mcp": "node --import tsx scripts/benchmark-mock.ts --scenario mcp",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "smol-toml": "1.7.1",
    "zod": "4.4.3"
  },
  "keywords": [
    "codex",
    "coding-agent",
    "repository-exploration",
    "subagent",
    "read-only",
    "pi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rycen7822/FreeContext.git"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
